    "version": "2.0.0",
    "tasks": [
        {
            "label": "Test (pwsh)",
            "type": "shell",
            "command": "pwsh -Command \"./test/test.ps1\"",
            "group": "build"
        },
        {
            "label": "Test (powershell)",
            "type": "shell",
            "command": "powershell -Command \"./test/test.ps1\"",
            "group": "build"
        },
        {
            "label": "Generate config.example.ps1",
            "type": "shell",
            "command": "pwsh -Command \". ./MarkOneNoteDown.ps1 -Exit; New-ConfigurationFile\"",
            "group": "build"
        },
        {
            "label": "Convert",
            "type": "shell",
            "command": "pwsh -Command \"./MarkOneNoteDown.ps1\"",
            "group": "none"
        },
        {
            "label": "Convert (verbose)",
            "type": "shell",
            "command": "pwsh -Command \"./MarkOneNoteDown.ps1 -Verbose\"",
            "group": "none"
        }
    ]
}
